# Maintainer: tetoMIDI <noreply@tetomidi.invalid>
# Build from a checkout:  cd packaging/arch && makepkg -si
pkgname=tetomidi
pkgver=1.4.0
pkgrel=1
pkgdesc='MIDI macro player with falling-note piano roll (piano, drums, guitar)'
arch=('x86_64' 'aarch64')
url='https://tetomidi-player.vercel.app/'
license=('GPL3')
depends=('python' 'tk' 'python-pillow' 'python-numpy' 'python-mido' 'python-pynput' 'python-xlib'
         'python-sounddevice' 'python-certifi' 'portaudio')
source=()   # uses the checkout two levels up, so no download is needed

package() {
  local root="$startdir/../.."
  install -d "$pkgdir/usr/lib/tetomidi" "$pkgdir/usr/bin" "$pkgdir/usr/share/applications" \
             "$pkgdir/usr/share/icons/hicolor/256x256/apps"
  cp -r "$root/tetomidi" "$root/assets" "$pkgdir/usr/lib/tetomidi/"
  find "$pkgdir/usr/lib/tetomidi" -name '__pycache__' -prune -exec rm -rf {} +
  printf '#!/bin/sh\nPYTHONPATH=/usr/lib/tetomidi exec python -m tetomidi "$@"\n' > "$pkgdir/usr/bin/tetomidi"
  chmod 755 "$pkgdir/usr/bin/tetomidi"
  install -Dm644 "$root/assets/app-256.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/tetomidi.png"
  cat > "$pkgdir/usr/share/applications/tetomidi.desktop" <<DESK
[Desktop Entry]
Type=Application
Name=tetoMIDI
Comment=MIDI macro player with piano roll (piano, drums, guitar)
Exec=tetomidi
Icon=tetomidi
Terminal=false
Categories=AudioVideo;Audio;Music;
StartupWMClass=TetoMIDI
DESK
  install -Dm644 "$root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
